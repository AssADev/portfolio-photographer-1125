{
	"name": "portfolio-photographer-1125",
	"type": "module",
	"version": "1.0.0",
	"imports": {
		"#*": "./src/*",
		"#tools/*": "./tools/*",
		"#integrations": "./integrations"
	},
	"scripts": {
		"dev": "astro dev --host",
		"build": "astro build",
		"preview": "node --env-file .env ./dist/server/entry.mjs",
		"astro": "astro",
		"eslint": "eslint './**/*.+(ts|mts|js|mjs|vue|astro)'",
		"stylelint": "stylelint './src/**/*.+(css|scss|vue|astro)'",
		"lint": "npx pnpm run eslint --fix && npx pnpm run stylelint --fix",
		"prettier": "prettier --write './**/*.+(ts|mts|js|mjs|vue|astro)'",
		"format": "npx pnpm run lint && npx pnpm run prettier",
		"check": "vue-tsc --noEmit && astro check --tsconfig ./astro.tsconfig.json",
		"sb-types:pull": "dotenv -e .env -- cross-var storyblok components pull --space %STORYBLOK_SPACE_ID%",
		"sb-types:generate": "dotenv -e .env -- cross-var storyblok types generate --strict --space %STORYBLOK_SPACE_ID% --type-prefix Storyblok",
		"sb-types:resolve": "dotenv -e .env -- cross-var npx tsx tools/resolveTypes.ts --space %STORYBLOK_SPACE_ID%",
		"sb-types:format": "npx prettier --write \"./src/types/component-types-sb*\"",
		"sb-types": "npm run sb-types:pull && npm run sb-types:generate && npm run sb-types:resolve && npm run sb-types:format"
	},
	"dependencies": {
		"@astrojs/vercel": "^9.0.5",
		"@astrojs/vue": "^5.1.3",
		"@hcaptcha/vue3-hcaptcha": "^1.3.0",
		"@nanostores/vue": "^1.0.1",
		"@storyblok/astro": "^7.3.5",
		"@storyblok/js": "^4.4.1",
		"@storyblok/vue": "^9.4.1",
		"@unpic/core": "^1.0.3",
		"@unpic/vue": "^1.0.0",
		"@vercel/analytics": "^2.0.1",
		"@vercel/speed-insights": "^2.0.0",
		"@vueuse/core": "^14.0.0",
		"@vueuse/integrations": "^14.1.0",
		"astro": "^5.15.9",
		"embla-carousel-vue": "^8.6.0",
		"focus-trap": "^7.6.6",
		"gsap": "^3.13.0",
		"lenis": "^1.3.15",
		"nanostores": "^1.1.0",
		"ogl": "^1.0.11",
		"sitemap": "^9.0.0",
		"tabbable": "^6.3.0",
		"unpic": "^4.2.2",
		"vee-validate": "^4.15.1",
		"vite-svg-loader": "^5.1.0",
		"vue": "^3.5.24",
		"winston": "^3.18.3"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.6",
		"@trivago/prettier-plugin-sort-imports": "^6.0.0",
		"@typescript-eslint/eslint-plugin": "^8.58.0",
		"@typescript-eslint/parser": "^8.58.0",
		"@vitejs/plugin-basic-ssl": "^2.1.0",
		"arg": "^5.0.2",
		"autoprefixer": "^10.4.22",
		"cross-var": "^1.1.0",
		"dotenv-cli": "^11.0.0",
		"eslint": "^9.39.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^1.5.0",
		"eslint-plugin-vue": "^10.5.1",
		"eslint-plugin-vuejs-accessibility": "^2.4.1",
		"globals": "^17.4.0",
		"lint-staged": "^16.2.7",
		"postcss": "^8.5.6",
		"postcss-html": "^1.8.1",
		"prettier": "^3.6.2",
		"prettier-plugin-astro": "^0.14.1",
		"sass-embedded": "^1.93.3",
		"serialize-error": "^12.0.0",
		"storyblok": "^4.7.0",
		"stylelint": "^16.25.0",
		"stylelint-config-css-modules": "^4.5.1",
		"stylelint-config-recess-order": "^7.4.0",
		"stylelint-config-recommended-scss": "^16.0.2",
		"stylelint-config-recommended-vue": "^1.6.1",
		"stylelint-config-standard": "^39.0.1",
		"stylelint-config-standard-scss": "^16.0.0",
		"stylelint-prettier": "^5.0.3",
		"ts-morph": "^27.0.2",
		"typescript-eslint": "^8.58.0",
		"vite": "^6.4.1",
		"vue-component-type-helpers": "^3.1.5",
		"vue-tsc": "^3.1.5"
	},
	"engines": {
		"node": ">=22",
		"npm": ">=10"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,jsx,tsx,json,jsonc,astro,vue}": [
			"bash -c 'vue-tsc --noEmit'",
			"eslint --cache --fix",
			"prettier --write --ignore-unknown"
		],
		"*.{css,scss,astro,vue}": [
			"stylelint --fix"
		]
	}
}
