---
import { Debug } from 'astro:components';
import type { SbBlokData } from '@storyblok/js';

type Props = {
	blok: SbBlokData;
};

const props = Astro.props;

// Only displayed in development (or in the Storyblok preview), never to the visitors :
const showDebug = import.meta.env.DEV || Astro.locals.isPreviewMode;
---

{
	showDebug && (
		<div>
			<Debug props={props} />
		</div>
	)
}
