---
import { storyblokEditable } from '#storyblok/helpers/storyblokEditable.ts';
import { slimRelations } from '#storyblok/helpers/slimStory.ts';
import BiographyCopyrightVue from '#storyblok/modules/biography/BiographyCopyright.vue';
import type { StoryblokBiographyCopyright } from '#types/component-types-sb.js';

type Props = {
	blok: StoryblokBiographyCopyright;
};

const { blok } = Astro.props;
---

<BiographyCopyrightVue
	{...storyblokEditable(blok, Astro.locals.isPreviewMode)}
	{...Astro.props}
	blok={slimRelations(blok)}
	client:visible
/>
