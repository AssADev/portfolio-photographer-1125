---
import { storyblokEditable } from '#storyblok/helpers/storyblokEditable.ts';
import { slimRelations } from '#storyblok/helpers/slimStory.ts';
import BiographyStrangersPortraitsVue from '#storyblok/modules/biography/BiographyStrangersPortraits.vue';
import type { StoryblokBiographyStrangersPortraits } from '#types/component-types-sb.js';

type Props = {
	blok: StoryblokBiographyStrangersPortraits;
};

const { blok } = Astro.props;
const { socials } = Astro.locals.siteConfig;
---

<BiographyStrangersPortraitsVue
	{...storyblokEditable(blok, Astro.locals.isPreviewMode)}
	{...Astro.props}
	blok={slimRelations(blok)}
	socials={socials}
	client:visible
/>
