---
import { storyblokEditable } from '#storyblok/helpers/storyblokEditable.ts';
import ProjectsMarqueeVue from '#storyblok/modules/ProjectsMarquee.vue';
import type { StoryblokProjectsMarquee, StoryblokRichtext, StoryblokLabelLink } from '#types/component-types-sb.js';
import { getProjects } from '#storyblok/helpers/getProjects.ts';

import locales from '#utils/locales.json';
import parseUrl from '#utils/parseUrl.ts';

type Props = {
	blok?: StoryblokProjectsMarquee;
	titleWithProjects?: StoryblokRichtext;
	titleWithoutProjects?: StoryblokRichtext;
	descriptionWithProjects?: string;
	descriptionWithoutProjects?: string;
	link?: StoryblokLabelLink[];
};

const { blok } = Astro.props;
const { marqueeLink } = Astro.locals.siteConfig;
const { language = locales[0] } = parseUrl(Astro.url.pathname);

// Fetch the projects :
const { projects, isFallback } = await getProjects(language, Astro.locals.isPreviewMode, Astro.locals.story?.tag_list);

const finalLink = Astro.props.link || blok?.link || marqueeLink;
---

<ProjectsMarqueeVue
	{...storyblokEditable(blok, Astro.locals.isPreviewMode)}
	{...Astro.props}
	isFallback={isFallback}
	link={finalLink}
	projects={projects}
	excludeUuid={Astro.locals.story?.uuid}
	client:visible
/>
