---
import { storyblokEditable } from '#storyblok/helpers/storyblokEditable.ts';
import ServicesHighlightVue from '#storyblok/modules/services/ServicesHighlight.vue';
import type { StoryblokServicesHighlight } from '#types/component-types-sb.js';
import { getProjectCountByTag } from '#storyblok/helpers/getProjectCountByTag.ts';

type Props = {
	blok: StoryblokServicesHighlight;
};

const { blok } = Astro.props;

// Fetch the number of projects associated with the service tag :
const service = blok.service?.[0];
const numberOfProjects =
	service && typeof service !== 'string' ? await getProjectCountByTag(service.name, Astro.locals.isPreviewMode) : 0;

// Find the service start price :
const serviceStartPrice = service && typeof service !== 'string' ? Number(service.content.offers?.[0].price || 0) : 0;
---

<ServicesHighlightVue
	{...storyblokEditable(blok, Astro.locals.isPreviewMode)}
	{...Astro.props}
	numberOfProjects={numberOfProjects}
	serviceStartPrice={serviceStartPrice}
	client:visible
/>
