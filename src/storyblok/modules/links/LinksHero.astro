---
import { storyblokEditable } from '#storyblok/helpers/storyblokEditable.ts';
import { slimRelations } from '#storyblok/helpers/slimStory.ts';
import LinksHeroVue from '#storyblok/modules/links/LinksHero.vue';
import type { StoryblokLinksHero } from '#types/component-types-sb.js';

type Props = {
	blok: StoryblokLinksHero;
};

const { blok } = Astro.props;
const { email, socials } = Astro.locals.siteConfig;
---

<LinksHeroVue
	{...storyblokEditable(blok, Astro.locals.isPreviewMode)}
	{...Astro.props}
	blok={slimRelations(blok)}
	email={email}
	socials={socials}
	client:visible
/>
