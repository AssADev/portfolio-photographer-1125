---
import { storyblokEditable } from '#storyblok/helpers/storyblokEditable.ts';
import { slimRelations } from '#storyblok/helpers/slimStory.ts';
import ServiceProjectsHighlightVue from '#storyblok/modules/service/ServiceProjectsHighlight.vue';
import type { StoryblokServiceProjectsHighlight } from '#types/component-types-sb.js';

type Props = {
	blok: StoryblokServiceProjectsHighlight;
};

const { blok } = Astro.props;
---

<ServiceProjectsHighlightVue
	{...storyblokEditable(blok, Astro.locals.isPreviewMode)}
	{...Astro.props}
	blok={slimRelations(blok)}
	client:visible
/>
