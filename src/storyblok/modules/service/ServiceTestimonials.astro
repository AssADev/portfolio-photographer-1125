---
import { slimRelations } from '#storyblok/helpers/slimStory.ts';
import { storyblokEditable } from '#storyblok/helpers/storyblokEditable.ts';
import ServiceTestimonialsVue from '#storyblok/modules/service/ServiceTestimonials.vue';
import type { StoryblokServiceTestimonials } from '#types/component-types-sb.js';

type Props = {
	blok: StoryblokServiceTestimonials;
};

const { blok } = Astro.props;
const { serviceTestimonialsTitle, serviceTestimonialsDescription, serviceTestimonialsLink } = Astro.locals.siteConfig;
---

<ServiceTestimonialsVue
	{...storyblokEditable(blok, Astro.locals.isPreviewMode)}
	{...Astro.props}
	blok={slimRelations(blok)}
	title={serviceTestimonialsTitle}
	description={serviceTestimonialsDescription}
	link={slimRelations(serviceTestimonialsLink)}
	client:visible
/>
