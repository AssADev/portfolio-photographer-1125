---
import { storyblokEditable } from '#storyblok/helpers/storyblokEditable.ts';
import ServiceHeroVue from '#storyblok/modules/service/ServiceHero.vue';
import type { StoryblokServiceInformations } from '#types/component-types-sb.js';

type Props = {
	blok: StoryblokServiceInformations;
};

const { blok } = Astro.props;

// The link to the services page is taken from the menu (already localized) :
const servicesLink = Astro.locals.siteConfig.menuLinks?.find((item) => item.link?.component === 'Services')?.link.url;
---

<ServiceHeroVue
	{...storyblokEditable(blok, Astro.locals.isPreviewMode)}
	{...Astro.props}
	servicesLink={servicesLink}
	client:visible
/>
