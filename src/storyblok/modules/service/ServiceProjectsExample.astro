---
import { storyblokEditable } from '#storyblok/helpers/storyblokEditable.ts';
import { slimRelations } from '#storyblok/helpers/slimStory.ts';
import ServiceProjectsExampleVue from '#storyblok/modules/service/ServiceProjectsExample.vue';
import type { StoryblokServiceProjectsExample } from '#types/component-types-sb.js';

type Props = {
	blok: StoryblokServiceProjectsExample;
};

const { blok } = Astro.props;
---

<ServiceProjectsExampleVue
	{...storyblokEditable(blok, Astro.locals.isPreviewMode)}
	{...Astro.props}
	blok={slimRelations(blok)}
	client:visible
/>
