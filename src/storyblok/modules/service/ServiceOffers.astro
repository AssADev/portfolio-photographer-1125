---
import ServiceOffersVue from '#storyblok/modules/service/ServiceOffers.vue';
import type { StoryblokServiceOffer } from '#types/component-types-sb.js';

type Props = {
	offers: StoryblokServiceOffer[];
};

const { offers } = Astro.props;
const { serviceOffersTitle, serviceOffersDescription, serviceBookingFormLink } = Astro.locals.siteConfig;
---

<ServiceOffersVue
	offers={offers}
	title={serviceOffersTitle}
	description={serviceOffersDescription}
	serviceBookingFormLink={serviceBookingFormLink}
	client:visible
/>
