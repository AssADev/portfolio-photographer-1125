---
import { storyblokEditable } from '#storyblok/helpers/storyblokEditable.ts';
import { slimRelations } from '#storyblok/helpers/slimStory.ts';
import ServiceOffersComparisonVue from '#storyblok/modules/service/ServiceOffersComparison.vue';
import type { StoryblokServiceOffer, StoryblokServiceOffersComparison } from '#types/component-types-sb.js';

type Props = {
	blok: StoryblokServiceOffersComparison;
	offers: StoryblokServiceOffer[];
};

const { blok, offers } = Astro.props;
const { serviceOffersComparisonTitle } = Astro.locals.siteConfig;
const isEvents = (Astro.locals.story?.full_slug ?? '').toLowerCase().includes('events');
---

<ServiceOffersComparisonVue
	{...storyblokEditable(blok, Astro.locals.isPreviewMode)}
	{...Astro.props}
	blok={slimRelations(blok)}
	title={serviceOffersComparisonTitle}
	offers={offers}
	isEvents={isEvents}
	client:visible
/>
