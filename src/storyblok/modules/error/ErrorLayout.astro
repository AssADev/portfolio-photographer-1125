---
import ErrorLayoutVue from '#storyblok/modules/error/ErrorLayout.vue';
import { getProjects } from '#storyblok/helpers/getProjects.ts';

import locales from '#utils/locales.json';
import parseUrl from '#utils/parseUrl.ts';

const { errorTitle, errorLink, errorDescription } = Astro.locals.siteConfig;
const { language = locales[0] } = parseUrl(Astro.url.pathname);

// Fetch the projects :
const { projects } = await getProjects(language, Astro.locals.isPreviewMode);
---

<ErrorLayoutVue
	{...Astro.props}
	errorTitle={errorTitle}
	errorLink={errorLink}
	errorDescription={errorDescription}
	projects={projects}
	client:visible
/>
