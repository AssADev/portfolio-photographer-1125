---
import { storyblokEditable } from '#storyblok/helpers/storyblokEditable.ts';
import QuotesVue from '#storyblok/modules/Quotes.vue';
import type { StoryblokQuotes } from '#types/component-types-sb.js';

type Props = {
	blok: StoryblokQuotes;
};

const { blok } = Astro.props;
---

<QuotesVue {...storyblokEditable(blok, Astro.locals.isPreviewMode)} {...Astro.props} client:visible />
