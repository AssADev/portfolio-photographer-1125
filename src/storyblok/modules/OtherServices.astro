---
import { storyblokEditable } from '#storyblok/helpers/storyblokEditable.ts';
import { slimRelations, slimStory } from '#storyblok/helpers/slimStory.ts';
import OtherServicesVue from '#storyblok/modules/OtherServices.vue';
import type { StoryblokOtherServices } from '#types/component-types-sb.js';
import { getServices } from '#storyblok/helpers/getServices.ts';

import locales from '#utils/locales.json';
import parseUrl from '#utils/parseUrl.ts';

type Props = {
	blok: StoryblokOtherServices;
};

const { blok } = Astro.props;
const { language = locales[0] } = parseUrl(Astro.url.pathname);

// Fetch the services :
const services = await getServices(blok.services, language, Astro.locals.isPreviewMode);
---

<OtherServicesVue
	{...storyblokEditable(blok, Astro.locals.isPreviewMode)}
	{...Astro.props}
	blok={slimRelations(blok)}
	services={services.map(slimStory)}
	client:visible
/>
