---
import type {
	StoryblokProject,
	StoryblokProjectInformations,
	StoryblokProjectLayout,
	StoryblokProjectItemPicture
} from '#types/component-types-sb.js';
import type { SbBlokData } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import ProjectHero from '#storyblok/modules/project/ProjectHero.astro';
import ProjectMinimap from '#storyblok/modules/project/ProjectMinimap.astro';

type Props = { blok: StoryblokProject };

const { blok } = Astro.props;

// Find all pictures :
const pictures =
	blok.body
		?.filter((c): c is StoryblokProjectLayout => c.component === 'ProjectLayout')
		.flatMap((c) => c.items)
		.filter((i): i is StoryblokProjectItemPicture => i.component === 'ProjectItemPicture')
		.map((i) => i.picture) ?? [];
---

{
	blok.informations?.length && (
		<ProjectHero
			blok={blok.informations[0] as StoryblokProjectInformations}
			pictures={pictures.map((p) => p.filename).filter((f): f is string => !!f)}
		/>
	)
}

<div class="modules-container">
	<div class="modules-inner-container">
		{
			blok.body?.map((blok, i) => {
				return (
					<StoryblokComponent
						blok={blok as SbBlokData}
						id={blok._uid}
						data-component-name={blok.component}
						pictures={pictures}
					/>
				);
			})
		}
	</div>
</div>

{pictures.length && <ProjectMinimap pictures={pictures} />}

<style lang="scss" scoped>
	.modules-container {
		@include pseudo-gradient('before', 'top', 'white-white-transparent', 1, fluidSize(240px, 160px));

		position: relative;
		background: $white;
		margin-block-start: calc(100vh + fluidSize(240px, 160px));

		&::before {
			transform: translate3d(0, calc(-100% + 2px), 0);
		}
	}

	.modules-inner-container {
		position: relative;
		z-index: 1;
	}
</style>
