---
import type { StoryblokBiography } from '#types/component-types-sb.js';
import type { SbBlokData } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';

type Props = { blok: StoryblokBiography };

const { blok } = Astro.props;
---

{
	blok.body?.map((blok, i) => {
		return <StoryblokComponent blok={blok as SbBlokData} id={blok._uid} data-component-name={blok.component} />;
	})
}
