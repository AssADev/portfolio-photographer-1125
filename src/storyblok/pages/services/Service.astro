---
import type {
	StoryblokService,
	StoryblokServiceInformations,
	StoryblokServiceOffers,
	StoryblokServiceFAQ,
	StoryblokOtherServices,
	StoryblokProjectsMarquee,
	StoryblokSteps,
	StoryblokServiceTestimonials,
	StoryblokServiceOffersComparison,
	StoryblokServiceProjectsHighlight,
	StoryblokServiceProjectsExample
} from '#types/component-types-sb.js';
import ServiceHero from '#storyblok/modules/service/ServiceHero.astro';
import ServiceOffers from '#storyblok/modules/service/ServiceOffers.astro';
import OtherServices from '#storyblok/modules/OtherServices.astro';
import ProjectsMarquee from '#storyblok/modules/ProjectsMarquee.astro';
import Steps from '#storyblok/modules/Steps.astro';
import ServiceFAQ from '#storyblok/modules/service/ServiceFAQ.astro';
import ServiceTestimonials from '#storyblok/modules/service/ServiceTestimonials.astro';
import ServiceOffersComparison from '#storyblok/modules/service/ServiceOffersComparison.astro';
import ServiceProjectsHighlight from '#storyblok/modules/service/ServiceProjectsHighlight.astro';
import ServiceProjectsExample from '#storyblok/modules/service/ServiceProjectsExample.astro';
import ServiceBreadcrumb from '#storyblok/partials/service/ServiceBreadcrumb.vue';

type Props = { blok: StoryblokService };

const { blok } = Astro.props;
const { faqTitle, faqDescription, faqLink, faqSections } = Astro.locals.siteConfig;
---

<ServiceBreadcrumb
	client:load
	hasTestimonials={!!blok.moduleTestimonials?.length}
	hasOffers={!!blok.moduleOffers?.length}
	hasFAQ={!!blok.moduleFAQ?.length}
/>

{
	blok.informations?.length && (
		<ServiceHero blok={blok.informations[0] as StoryblokServiceInformations} data-component-name="ServiceHero" />
	)
}

{
	blok.moduleProjectsHighlight?.length && (
		<ServiceProjectsHighlight
			blok={blok.moduleProjectsHighlight[0] as StoryblokServiceProjectsHighlight}
			data-component-name="ServiceProjectsHighlight"
		/>
	)
}

{blok.moduleSteps?.length && <Steps blok={blok.moduleSteps[0] as StoryblokSteps} data-component-name="Steps" />}

{
	blok.moduleTestimonials?.length && (
		<ServiceTestimonials
			blok={blok.moduleTestimonials[0] as StoryblokServiceTestimonials}
			data-component-name="ServiceTestimonials"
		/>
	)
}

{
	blok.moduleProjectsExample?.length && (
		<ServiceProjectsExample
			blok={blok.moduleProjectsExample[0] as StoryblokServiceProjectsExample}
			data-component-name="ServiceProjectsExample"
		/>
	)
}

{
	blok.moduleOffers?.length && (
		<ServiceOffers
			blok={blok.moduleOffers[0] as StoryblokServiceOffers}
			offers={blok.offers ?? []}
			data-component-name="ServiceOffers"
		/>
	)
}

{
	blok.moduleOffersComparison?.length && (
		<ServiceOffersComparison
			blok={blok.moduleOffersComparison[0] as StoryblokServiceOffersComparison}
			offers={blok.offers ?? []}
			data-component-name="ServiceOffersComparison"
		/>
	)
}

{
	blok.moduleFAQ?.length && (
		<ServiceFAQ
			blok={blok.moduleFAQ[0] as StoryblokServiceFAQ}
			faqTitle={faqTitle}
			faqDescription={faqDescription}
			faqLink={faqLink}
			faqSections={faqSections}
			data-component-name="ServiceFAQ"
		/>
	)
}

{
	blok.moduleOtherServices?.length && (
		<OtherServices
			blok={blok.moduleOtherServices[0] as StoryblokOtherServices}
			data-component-name="OtherServices"
		/>
	)
}

{
	blok.moduleProjectsMarquee?.length && (
		<ProjectsMarquee
			blok={blok.moduleProjectsMarquee[0] as StoryblokProjectsMarquee}
			data-component-name="ProjectsMarquee"
		/>
	)
}
