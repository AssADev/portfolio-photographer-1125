---
import type {
	StoryblokService,
	StoryblokServiceInformations,
	StoryblokServiceOffers
} from '#types/component-types-sb.js';
import type { SbBlokData } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import ServiceHero from '#storyblok/modules/service/ServiceHero.astro';
import ServiceOffers from '#storyblok/modules/service/ServiceOffers.vue';

type Props = { blok: StoryblokService };

const { blok } = Astro.props;
---

<ServiceHero blok={blok.informations[0] as StoryblokServiceInformations} />

{
	blok.body?.map((bodyBlok) => {
		if (bodyBlok.component === 'ServiceOffers') {
			return <ServiceOffers blok={bodyBlok as StoryblokServiceOffers} offers={blok.offers ?? []} />;
		} else {
			return (
				<StoryblokComponent
					blok={bodyBlok as SbBlokData}
					id={bodyBlok._uid}
					data-component-name={bodyBlok.component}
				/>
			);
		}
	})
}
