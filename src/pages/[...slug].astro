---
import '#styles/app.scss';

import BaseLayout from '#layouts/BaseLayout.astro';
import { type ISbStoryData } from '@storyblok/astro';

import { useStoryblokApi } from '@storyblok/astro';
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import type { PageContentTypes } from '#types/utils.ts';

import parseUrl from '#utils/parseUrl.ts';
import locales from '#utils/locales.json';
import { HOME_SLUG } from '#storyblok/helpers/specialSlugs.ts';
import fetchStory from '#storyblok/helpers/fetchStory.ts';
import { AppError } from '#lib/AppError.ts';
import getSiteConfig from '#storyblok/helpers/getSiteConfig.ts';

// Variables :
let story: ISbStoryData<PageContentTypes>;
const isPreviewMode = Astro.locals.isPreviewMode;

const params = Astro.params;
const props = parseUrl(params?.slug);
const { slug = HOME_SLUG, language = locales[0] } = props;

// Redirection logic for default locale :
// If the URL starts with the default locale (explicitly), we redirect to the version without it.
// Example: /fr/biography -> /biography
if (params.slug?.startsWith(locales[0] + '/')) {
	return Astro.redirect(`/${params.slug.replace(locales[0] + '/', '')}`);
} else if (params.slug === locales[0]) {
	return Astro.redirect('/');
}

// Handle dev tool route send by Chrome for some reason :
// https://stackoverflow.com/questions/79629915/well-known-appspecific-com-chrome-devtools-json-request
if (slug.startsWith('.')) return Astro.rewrite('/500');

// Early rewrite to 404 for unkown astro assets to avoid querying Storyblok :
if (slug.startsWith('_astro/')) return Astro.rewrite('/404');

try {
	// Parallelize independent API calls: siteConfig and story fetching
	const [siteConfig, storyResult] = await Promise.all([
		getSiteConfig(language, isPreviewMode),
		fetchStory(slug, language, isPreviewMode)
	]);

	// If the story is not found, which should never happen without throwing an error, throw 404 :
	if (!storyResult) throw AppError.notFound(slug, language);

	Astro.locals.siteConfig = siteConfig.content;

	// Deep clone the story to avoid mutating the original story cacheable by Storyblok :
	story = structuredClone(storyResult);

	Astro.response.headers.set('Cache-Control', 'public, max-age=600, s-maxage=31536000');

	const storyblokApi = useStoryblokApi();
	Astro.response.headers.set('X-Storyblok-CV', storyblokApi.cacheVersion().toString());
} catch (e: any) {
	const error = AppError.autoError(e, slug, language);

	Astro.response.status = error.statusCode;
	return Astro.rewrite(error.redirectPath);
}
---

<BaseLayout language={language} story={story}>
	<StoryblokComponent blok={story.content as any} />
</BaseLayout>
