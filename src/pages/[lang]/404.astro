---
import '#styles/app.scss';

import BaseLayout from '#layouts/BaseLayout.astro';
import getSiteConfig from '#storyblok/helpers/getSiteConfig.ts';

import { t } from '#utils/i18n.ts';
import locales from '#utils/locales.json';
import { setState } from '#utils/astro-state.ts';

import ErrorLayout from '#storyblok/modules/error/ErrorLayout.astro';

const { lang } = Astro.params;
const language = (lang as string) || locales[0];

if (!Astro.locals.siteConfig) {
	// Get site config - needed if 404 isn't triggered by [..slug].astro (api routes for example) :
	const siteConfig = await getSiteConfig(language, Astro.locals.isPreviewMode);
	Astro.locals.siteConfig = siteConfig.content;
}

setState('language', language);

Astro.response.status = 404;
Astro.response.headers.set('Cache-Control', 'max-age=300');
---

<BaseLayout language={language} story={{ name: t('pageNotFound') }}>
	<ErrorLayout language={language} />
</BaseLayout>
