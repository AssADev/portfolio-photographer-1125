<script>
	import { isWebView } from '#utils/iosWebViewDetector.ts';
	import { type TransitionBeforeSwapEvent, swapFunctions } from 'astro:transitions/client';

	/* ----- Keyboard focus ----- */
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Tab') document.body.classList.add('keyboard-focus');
		document.addEventListener('mousemove', () => document.body.classList.remove('keyboard-focus'), {
			once: true
		});
	});

	/* ----- Scroll management ----- */
	if ('scrollRestoration' in history) {
		history.scrollRestoration = 'manual';
	}

	document.addEventListener('astro:after-swap', () => {
		window.scrollTo(0, 0);
	});

	/* ----- Custom swap ----- */
	function customSwap(doc: Document) {
		swapFunctions.deselectScripts(doc);

		// Preserve custom CSS properties before swapping root attributes
		const preservedLvh = document.documentElement.style.getPropertyValue('--lvh');
		const preservedSvh = document.documentElement.style.getPropertyValue('--svh');

		swapFunctions.swapRootAttributes(doc);

		// Restore custom CSS properties after the swap
		if (preservedLvh) document.documentElement.style.setProperty('--lvh', preservedLvh);
		if (preservedSvh) document.documentElement.style.setProperty('--svh', preservedSvh);

		const otStyle = document.head.querySelector<HTMLStyleElement>('#onetrust-style');

		swapFunctions.swapHeadElements(doc);

		if (otStyle) document.head.appendChild(otStyle);
		const restoreFocusFunction = swapFunctions.saveFocus();

		const oldApp = document.body.querySelector('#app')!;
		const newApp = doc.body.querySelector('#app')!;

		oldApp.replaceWith(newApp);

		restoreFocusFunction();
	}

	const beforeSwap = (e: TransitionBeforeSwapEvent) => {
		e.swap = () => customSwap(e.newDocument);
	};

	document.addEventListener('astro:before-swap', beforeSwap);

	/* ----- Legacy viewport height ----- */
	const WEB_VIEW_OFFSET = 115;

	if (isWebView) {
		const savedHeight = sessionStorage.getItem('webview-lvh');
		const lvh = savedHeight ? parseInt(savedHeight) : window.innerHeight + WEB_VIEW_OFFSET;
		document.documentElement.style.setProperty('--lvh', `${lvh * 0.01}px`);

		const savedSvh = sessionStorage.getItem('webview-svh');
		const svh = savedSvh ? parseInt(savedSvh) : document.documentElement.clientHeight || window.innerHeight;

		if (svh > 0) {
			sessionStorage.setItem('webview-svh', svh.toString());
			document.documentElement.style.setProperty('--svh', `${svh * 0.01}px`);
		}

		window.addEventListener('resize', () => {
			const newHeight = window.innerHeight;
			const currentLvh = parseInt(sessionStorage.getItem('webview-lvh') || '0');
			if (newHeight > currentLvh) {
				sessionStorage.setItem('webview-lvh', newHeight.toString());
				document.documentElement.style.setProperty('--lvh', `${newHeight * 0.01}px`);
			}
		});
	} else {
		// On regular Safari, we MUST NOT set --svh to 0 or even define it if we want the CSS fallback to work.
		// However, for consistency with the mixin, we can set it to the native unit.
		document.documentElement.style.setProperty('--svh', '1svh');
		document.documentElement.style.setProperty('--lvh', '1lvh');
	}
</script>
