---
import type { StoryblokSEO } from '#types/component-types-sb.js';
import type { ExtendedTagsType, LanguageAlternate } from '#types/seo.ts';

type Props = {
	seo?: StoryblokSEO;
	storyTitle?: string;
	fallbackDescription?: string;
	themeColor?: string;
	canonical?: URL | string;
	nofollow?: boolean;
	noindex?: boolean;
	extend?: ExtendedTagsType;
	languageAlternates?: LanguageAlternate[];
	locale?: string;
	localeAlternates?: string[];
};

import ExtendedTags from '#components/widgets/Head/ExtendedTags.astro';
import Favicon from '#components/widgets/Head/Favicon.astro';
import LanguageAlternatesTags from '#components/widgets/Head/LanguageAlternatesTags.astro';
import OpenGraphBasicTags from '#components/widgets/Head/OpenGraphBasicTags.astro';
import OpenGraphOptionalTags from '#components/widgets/Head/OpenGraphOptionalTags.astro';
import TwitterTags from '#components/widgets/Head/TwitterTags.astro';
import { transform as sbTransform } from 'unpic/providers/storyblok';

const {
	seo,
	storyTitle,
	fallbackDescription,
	themeColor,
	canonical,
	noindex,
	nofollow,
	extend,
	languageAlternates,
	locale,
	localeAlternates
} = Astro.props;

const { titleTemplate, defaultTitle, defaultDescription, defaultImage, favicon, identity } = Astro.locals.siteConfig;

const pageTitle = seo?.title || storyTitle;
const title = pageTitle ? titleTemplate.replace(/%s/g, pageTitle) : defaultTitle;
const description = seo?.description || fallbackDescription || defaultDescription;

// Open Graph image (1200x630, the recommended size for the social networks) :
const OG_IMAGE_SIZE = { width: 1200, height: 630 };
const ogImageAsset = seo?.og_image?.filename ? seo.og_image : defaultImage;
const ogImage = ogImageAsset?.filename ? sbTransform(ogImageAsset.filename, OG_IMAGE_SIZE) : undefined;
// The alt texts of the assets are generated from their filename when empty, so the title is more relevant here :
const ogImageAlt = seo?.og_title || title;

// Canonical URL : without query string (e.g. tracking parameters) nor trailing slash, to avoid duplicates :
const baseUrl = Astro.site ?? Astro.url;
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalUrl = canonical ? canonical.toString() : new URL(pathname, baseUrl).href;

// Open Graph uses `fr_FR` instead of `fr-FR` :
const toOgLocale = (value: string) => value.replace('-', '_');

// `max-image-preview:large` allows Google to display the pictures in large (Discover, Images...) :
const robots = noindex
	? `noindex, ${nofollow ? 'nofollow' : 'follow'}`
	: `index, ${nofollow ? 'nofollow' : 'follow'}, max-image-preview:large`;
---

{title && <title>{title}</title>}
{description && <meta name="description" content={description} />}
{!!seo?.keywords?.length && <meta name="keywords" content={seo.keywords} />}
{themeColor && <meta name="theme-color" content={themeColor} />}

<meta name="robots" content={robots} />
{!noindex && <link rel="canonical" href={canonicalUrl} />}

<OpenGraphBasicTags
	title={seo?.og_title || title}
	image={ogImage}
	imageWidth={ogImage ? OG_IMAGE_SIZE.width : undefined}
	imageHeight={ogImage ? OG_IMAGE_SIZE.height : undefined}
	imageAlt={ogImage ? ogImageAlt : undefined}
	url={canonicalUrl}
/>
<OpenGraphOptionalTags
	description={seo?.og_description || description}
	siteName={identity}
	locale={locale ? toOgLocale(locale) : undefined}
	localeAlternate={localeAlternates?.map(toOgLocale)}
/>
<TwitterTags
	card="summary_large_image"
	title={seo?.og_title || title}
	description={seo?.og_description || description}
	image={ogImage}
	imageAlt={ogImage ? ogImageAlt : undefined}
/>

{extend && <ExtendedTags {...extend} />}
{!noindex && languageAlternates && <LanguageAlternatesTags languageAlternates={languageAlternates} />}
{favicon?.filename && <Favicon src={favicon.filename} />}
