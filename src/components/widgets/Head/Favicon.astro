---
type Props = {
	src: string;
};

const { src } = Astro.props;

const isSvg = src.split('?')[0].endsWith('.svg');

// The Storyblok image service can resize the favicon and convert it to PNG (needed by iOS, which doesn't support SVG) :
const png = (size: number) => `${src}/m/${size}x${size}/filters:format(png)`;
---

{isSvg && <link rel="icon" type="image/svg+xml" href={src} />}
<link rel="icon" type="image/png" sizes="32x32" href={png(32)} />
<link rel="icon" type="image/png" sizes="192x192" href={png(192)} />
<link rel="apple-touch-icon" sizes="180x180" href={png(180)} />
