---
import { getImage } from 'astro:assets';

type Props = {
	src: string;
};

const { src } = Astro.props;

// Generate different favicon sizes :
const favicon32 = await getImage({ src: src, width: 32, height: 32 });
const favicon192 = await getImage({ src: src, width: 192, height: 192 });
const favicon152 = await getImage({ src: src, width: 152, height: 152 });
const favicon310 = await getImage({ src: src, width: 310, height: 310 });

// Apple specific sizes :
const touchIconIphone = await getImage({ src: src, width: 57, height: 57 });
const touchIconIpad = await getImage({ src: src, width: 76, height: 76 });
const touchIconIphoneRetina = await getImage({ src: src, width: 120, height: 120 });
const touchIconIpadRetina = await getImage({ src: src, width: 152, height: 152 });

// Microsoft specific sizes :
const iconSmallTile = await getImage({ src: src, width: 70, height: 70 });
const iconMediumTile = await getImage({ src: src, width: 150, height: 150 });
const iconWideTile = await getImage({ src: src, width: 310, height: 150 });
---

<link rel="icon" type="image/png" href={favicon32.src} />
<link rel="icon" sizes="192x192" href={favicon192.src} />
<link rel="apple-touch-icon" href={favicon152.src} />
<meta name="msapplication-square310x310logo" content={favicon310.src} />

<link rel="apple-touch-icon" href={touchIconIphone.src} />
<link rel="apple-touch-icon" sizes="76x76" href={touchIconIpad.src} />
<link rel="apple-touch-icon" sizes="120x120" href={touchIconIphoneRetina.src} />
<link rel="apple-touch-icon" sizes="152x152" href={touchIconIpadRetina.src} />

<meta name="msapplication-square70x70logo" content={iconSmallTile.src} />
<meta name="msapplication-square150x150logo" content={iconMediumTile.src} />
<meta name="msapplication-wide310x150logo" content={iconWideTile.src} />
