---
import type { StoryblokSEO } from '#types/component-types-sb.js';
import type { PageContentTypes } from '#types/utils.ts';
import type { LanguageAlternate } from '#types/seo.ts';
import type { ISbStoryData } from '@storyblok/astro';

import Lenis from '#components/providers/Lenis.vue';

import SEO from '#components/widgets/Head/SEO.astro';
import Head from '#components/widgets/Head/Head.astro';
import Interloader from '#components/widgets/Interloader.vue';
import Loader from '#components/widgets/Loader.vue';
import TrackingScripts from '#components/scripts/TrackingScripts.astro';

import Header from '#components/widgets/Header.vue';
import Cursor from '#components/widgets/Cursor.vue';
import CursorProjects from '#components/widgets/CursorProjects.vue';

import ScriptUtilities from '#components/scripts/ScriptUtilities.astro';

import { setState } from '#utils/astro-state.ts';
import localesRegions from '#utils/localesRegions.ts';
import getAlternatesForStory from '#storyblok/helpers/getAlternatesForStory.ts';
import { fetchProjectImagesServer } from '#storyblok/helpers/getProjectImages.ts';
import Grainient from '#components/widgets/Grainient.vue';

type Props = {
	language: string;
	story?: Partial<ISbStoryData<PageContentTypes>>;
	alternates?: LanguageAlternate[];
	noindex?: boolean;
	nofollow?: boolean;
};

const siteConfig = Astro.locals.siteConfig;
const { language, story, noindex, nofollow } = Astro.props;

// SEO :
const seoRaw: StoryblokSEO[] | undefined = (story?.content as any)?.SEO;
const seo = Array.isArray(seoRaw) ? seoRaw[0] : seoRaw;

// Languages :
const lang = localesRegions[language];
const languageAlternates = story ? getAlternatesForStory(Astro.site!.toString(), story, language) : undefined;

// Get project images :
const projectImages = await fetchProjectImagesServer();

// State :
setState('language', language);
setState('url', Astro.url);
---

<html lang={lang}>
	<Head>
		<SEO
			storyTitle={story?.name}
			seo={seo}
			languageAlternates={languageAlternates}
			nofollow={nofollow}
			noindex={noindex}
		/>
		<script is:inline>
			(function () {
				const skipLoader = new URLSearchParams(window.location.search).has('skipLoader');
				if (!window.isSiteLoaded && !skipLoader) {
					document.documentElement.classList.add('is-site-loading');
				}
				if (!skipLoader) {
					if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
					window.scrollTo(0, 0);
				}
			})();
		</script>
		<style is:global>
			html.is-site-loading #app {
				visibility: hidden !important;
			}
		</style>
		<TrackingScripts />
		<slot name="head" />
	</Head>
	<body>
		<Grainient client:only="vue" />
		<Loader client:only="vue" identity={siteConfig.identity} />
		<Interloader client:only="vue" />
		<div id="app">
			<Cursor client:load />
			<CursorProjects client:load images={projectImages} />
			<Header siteConfig={siteConfig} language={language} languageAlternates={languageAlternates} client:load />
			<main>
				<Lenis client:load root />
				<slot />
			</main>
		</div>
	</body>
</html>

<ScriptUtilities />
